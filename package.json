{
  "name": "akazas-love",
  "displayName": "Akaza's Love - Musical Typing 🎶 and Falling Snow ❄️",
  "description": "Transform your typing into beautiful melody and animated snowfall",
  "publisher": "lanly-dev",
  "version": "1.0.1",
  "sponsor": {
    "url": "https://github.com/sponsors/lanly-dev"
  },
  "engines": {
    "vscode": "^1.104.0"
  },
  "categories": [
    "Other"
  ],
  "keywords": [
    "akaza",
    "anime",
    "demon slayer",
    "happy",
    "hakuji",
    "infinity castle",
    "kimetsu no yaiba",
    "koyuki",
    "melody",
    "music",
    "musical typing",
    "relaxing",
    "snow effect",
    "snowfall",
    "snowflakes",
    "typing sound"
  ],
  "icon": "media/akaza.png",
  "galleryBanner": {
    "color": "#fff",
    "theme": "light"
  },
  "activationEvents": [
    "onStartupFinished"
  ],
  "main": "./dist/extension.js",
  "contributes": {
    "viewsContainers": {
      "activitybar": [
        {
          "id": "akazas-love-webview",
          "title": "Piano Typing",
          "icon": "media/akaza.svg"
        }
      ]
    },
    "views": {
      "akazas-love-webview": [
        {
          "type": "webview",
          "id": "akazas-love.webview",
          "name": "Webview",
          "icon": "media/akaza.svg"
        }
      ]
    },
    "commands": [
      {
        "command": "akazas-love.playSong",
        "title": "Play demo",
        "icon": "$(play)"
      },
      {
        "command": "akazas-love.stopSong",
        "title": "Stop demo",
        "icon": "$(stop)"
      },
      {
        "command": "akazas-love.toggleMusicTyping",
        "title": "Toggle Music Typing"
      },
      {
        "command": "akazas-love.showPanel",
        "title": "Show web panel"
      },
      {
        "command": "akazas-love.openSettings",
        "title": "Open Musical Typing Settings",
        "icon": "$(gear)"
      }
    ],
    "menus": {
      "commandPalette": [],
      "view/title": [
        {
          "command": "akazas-love.playSong",
          "when": "view == akazas-love.webview && akazas-love.playing == false",
          "group": "navigation@97"
        },
        {
          "command": "akazas-love.stopSong",
          "when": "view == akazas-love.webview && akazas-love.playing == true",
          "group": "navigation@97"
        },
        {
          "command": "akazas-love.openSettings",
          "when": "view == akazas-love.webview",
          "group": "navigation@101"
        }
      ]
    },
    "configuration": {
      "title": "Akaza's Love",
      "properties": {
        "akazas-love.musicTyping": {
          "type": "boolean",
          "default": true,
          "description": "Enable musical typing sounds"
        },
        "akazas-love.volume": {
          "type": "number",
          "default": 0.1,
          "minimum": 0,
          "maximum": 1,
          "description": "Volume level for musical notes (0.0 to 1.0)"
        },
        "akazas-love.shuffle": {
          "type": "boolean",
          "default": false,
          "description": "Shuffle through songs in the playlist"
        },
        "akazas-love.loop": {
          "type": "boolean",
          "default": true,
          "description": "Loop the playlist when it reaches the end"
        }
      }
    }
  },
  "scripts": {
    "vscode:prepublish": "npm run build",
    "build": "node ./build.js",
    "build-dev": "node ./build.js --dev",
    "vsce-package": "vsce package",
    "efix": "eslint . --fix"
  },
  "dependencies": {
    "@tonejs/midi": "^2.0.28",
    "follow-redirects": "^1.15.11",
    "mpg123-decoder": "^1.0.3"
  },
  "devDependencies": {
    "@types/node": "24.x",
    "@types/vscode": "^1.104.0",
    "@vscode/vsce": "^3.6.2",
    "esbuild": "^0.25.10",
    "eslint": "^9.37.0",
    "minify": "^14.1.0",
    "ovsx": "^0.10.6"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/lanly-dev/vscode-akazas-love.git"
  },
  "bugs": {
    "url": "https://github.com/lanly-dev/vscode-akazas-love/issues"
  },
  "license": "MIT"
}
