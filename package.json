{
  "name": "akazas-love",
  "displayName": "Akaza's Love - Musical Typing",
  "description": "Transform your typing into beautiful melody",
  "publisher": "lanly-dev",
  "version": "1.2.1",
  "sponsor": {
    "url": "https://github.com/sponsors/lanly-dev"
  },
  "engines": {
    "vscode": "^1.104.0"
  },
  "categories": [
    "Other"
  ],
  "keywords": [
    "anime",
    "happy",
    "koyuki",
    "melody",
    "music",
    "musical typing",
    "relaxing",
    "typing sound"
  ],
  "icon": "icons/akaza.png",
  "galleryBanner": {
    "color": "#fff",
    "theme": "light"
  },
  "activationEvents": [
    "onStartupFinished"
  ],
  ".main": "./dist/extension.js",
  "main": "dist/standalone/main.js",
  "contributes": {
    "viewsContainers": {
      "activitybar": [
        {
          "id": "akazas-love-webview",
          "title": "Piano Typing",
          "icon": "icons/akaza.svg"
        }
      ]
    },
    "views": {
      "akazas-love-webview": [
        {
          "type": "webview",
          "id": "akazas-love.webview",
          "name": "Webview",
          "icon": "icons/akaza.svg"
        }
      ]
    },
    "commands": [
      {
        "command": "akazas-love.playSong",
        "title": "Play demo",
        "icon": "$(play)"
      },
      {
        "command": "akazas-love.stopSong",
        "title": "Stop demo",
        "icon": "$(stop)"
      },
      {
        "command": "akazas-love.toggleMusicTyping",
        "title": "Toggle Music Typing"
      },
      {
        "command": "akazas-love.showPanel",
        "title": "Show web panel"
      },
      {
        "command": "akazas-love.openSettings",
        "title": "Open Musical Typing Settings",
        "icon": "$(gear)"
      }
    ],
    "menus": {
      "commandPalette": [],
      "view/title": [
        {
          "command": "akazas-love.playSong",
          "when": "view == akazas-love.webview && akazas-love.playing == false",
          "group": "navigation@97"
        },
        {
          "command": "akazas-love.stopSong",
          "when": "view == akazas-love.webview && akazas-love.playing == true",
          "group": "navigation@97"
        },
        {
          "command": "akazas-love.openSettings",
          "when": "view == akazas-love.webview",
          "group": "navigation@101"
        }
      ]
    },
    "configuration": {
      "title": "Akaza's Love",
      "properties": {
        "akazas-love.musicTyping": {
          "type": "boolean",
          "default": true,
          "description": "Enable musical typing sounds"
        },
        "akazas-love.volume": {
          "type": "number",
          "default": 0.1,
          "minimum": 0,
          "maximum": 1,
          "description": "Volume level for musical notes (0.0 to 1.0)"
        },
        "akazas-love.shuffle": {
          "type": "boolean",
          "default": false,
          "description": "Shuffle through songs in the playlist"
        },
        "akazas-love.loop": {
          "type": "boolean",
          "default": true,
          "description": "Loop the playlist when it reaches the end"
        },
        "akazas-love.mediaDir": {
          "type": "string",
          "default": "D:\\Programs\\vscode-akazas-love\\media",
          "description": "Path to folder containing MIDI files"
        },
        "akazas-love.windowSize": {
          "type": "number",
          "default": 0.2,
          "description": "Size of note window in seconds"
        },
        "akazas-love.maxDelay": {
          "type": "number",
          "default": 3,
          "description": "Max amount of music that can be accumulated."
        }
      }
    }
  },
  "scripts": {
    "vscode:prepublish": "npm run build",
    "build": "node ./build.js",
    "build-dev": "node ./build.js --dev",
    "vsce-package": "vsce package",
    "efix": "eslint . --fix",
    "standalone": "electron dist/standalone/main.js",
    "standalone:dev": "node build.js --dev && electron dist/standalone/main.js",
    "dist": "node build.js && electron-builder --win portable",
    "postinstall": "electron-builder install-app-deps" 
  },
  "build": {
    "appId": "com.lanly-dev.akazas-love",
    "productName": "Akaza's Love",
    "directories": {
      "app": ".",
      "output": "release"
    },
    "files": [
      "dist/standalone/**",
      "node_modules/**",
      "icons/**",
      "package.json"
    ],
    "extraResources": [
      { "from": "icons/", "to": "icons/" }
    ],
    "win": {
      "icon": "icons/tray.ico",
      "target": [{ "target": "portable" }]
    },
    "portable": {
      "artifactName": "AkazasLove-portable.exe"
    },
    "npmRebuild": true,
    "buildDependenciesFromSource": false
  },
  "dependencies": {
    "@tonejs/midi": "^2.0.28",
    "follow-redirects": "^1.15.11",
    "get-windows": "^9.3.0",
    "mpg123-decoder": "^1.0.3",
    "node-liblzma": "^4.0.2",
    "uiohook-napi": "^1.5.5"
  },
  "devDependencies": {
    "@types/node": "24.x",
    "@types/vscode": "^1.104.0",
    "@vscode/vsce": "^3.6.2",
    "electron": "^42.0.1",
    "electron-builder": "^26.8.1",
    "electron-rebuild": "^3.2.9",
    "esbuild": "^0.25.10",
    "eslint": "^9.37.0",
    "minify": "^14.1.0",
    "ovsx": "^0.10.6"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/lanly-dev/vscode-akazas-love.git"
  },
  "bugs": {
    "url": "https://github.com/lanly-dev/vscode-akazas-love/issues"
  },
  "license": "MIT"
}
